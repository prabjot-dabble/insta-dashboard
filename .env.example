# Copy this file to .env and fill in real values for local development.
# Every variable below is read server-side only (in lib/instagram/client.ts and API routes).
# None of these are ever exposed to the browser — do not prefix any of them with NEXT_PUBLIC_.

# Use a long-lived User Access Token (~60 days) or a System User token (no fixed expiry). A token
# copied straight from Graph API Explorer only lasts ~1-2 hours — fine for local testing, not for
# anything left running.
#
# Required scope: instagram_manage_insights. This is NOT the same as read_insights (that scope
# covers Facebook Page insights, not Instagram Business insights) — a token missing
# instagram_manage_insights will still succeed on basic profile/media calls but fail specifically
# on insights calls (reach, impressions, engagement, etc).
META_ACCESS_TOKEN=
META_INSTAGRAM_BUSINESS_ID=

# Verified manually against the real Dabble account via Graph API Explorer (v25.0). Do not
# downgrade without a concrete compatibility reason found during implementation.
META_GRAPH_API_VERSION=v25.0
META_REQUEST_TIMEOUT_SECONDS=15

# --- Dashboard access (unrelated to the Meta credentials above) ---
# HTTP Basic Auth gate for the whole app, enforced in proxy.ts — this is a separate login layer in
# front of the dashboard, not a Meta/Instagram credential. Both must be set or the proxy fails
# closed (denies everyone with a 500) rather than leaving the dashboard accidentally public.
DASHBOARD_USER=
DASHBOARD_PASSWORD=
