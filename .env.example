# Copy this file to .env and fill in real values for local development.
# Every variable below is read server-side only (in lib/instagram/client.ts and API routes).
# None of these are ever exposed to the browser — do not prefix any of them with NEXT_PUBLIC_.

# Use a long-lived User Access Token (~60 days) or a System User token (no fixed expiry). A token
# copied straight from Graph API Explorer only lasts ~1-2 hours — fine for local testing, not for
# anything left running.
#
# Required scope: instagram_manage_insights. This is NOT the same as read_insights (that scope
# covers Facebook Page insights, not Instagram Business insights) — a token missing
# instagram_manage_insights will still succeed on basic profile/media calls but fail specifically
# on insights calls (reach, impressions, engagement, etc).
META_ACCESS_TOKEN=
META_INSTAGRAM_BUSINESS_ID=

# Verified manually against the real Dabble account via Graph API Explorer (v25.0). Do not
# downgrade without a concrete compatibility reason found during implementation.
META_GRAPH_API_VERSION=v25.0
META_REQUEST_TIMEOUT_SECONDS=15

# --- Dashboard sign-in (Google, free) ---
# Only people on ALLOWED_EMAILS can open the dashboard, after signing in with Google.
# 1. Google Cloud Console -> APIs & Services -> Credentials -> Create credentials -> OAuth client ID
#    (type "Web application"). Add this Authorized redirect URI:
#      http://localhost:3000/api/auth/callback   (plus https://<your-domain>/api/auth/callback when deployed)
# 2. Paste the client ID and secret below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated emails allowed in (case-insensitive). Empty = nobody can sign in.
ALLOWED_EMAILS=
# Random secret (32+ characters) that signs session cookies. Changing it signs everyone out.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# Optional: the public base URL when deployed (e.g. https://dash.example.com). Pins the Google
# redirect URI instead of trusting the request's Host header.
AUTH_URL=

# --- Optional: competitor benchmark (free, Meta Business Discovery) ---
# Comma-separated Instagram usernames of business/creator accounts to compare against, e.g.
# COMPETITOR_USERNAMES=brand_one,brand_two. Leave empty to hide the Competitors section.
COMPETITOR_USERNAMES=
